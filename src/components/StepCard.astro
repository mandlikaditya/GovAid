---
interface Props {
  number: string | number;
  title: string;
  description: string;
}

const { number, title, description } = Astro.props;
---

<article class="flex flex-col group">
  <dt class="flex items-center gap-x-4 text-2xl font-bold leading-7 text-slate-900 dark:text-white">
    <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-700 text-white shrink-0 shadow-lg shadow-blue-200 dark:shadow-blue-900/20 group-hover:scale-110 transition-transform duration-300" aria-hidden="true">
      {number}
    </span>
    {title}
  </dt>
  <dd class="mt-6 flex flex-auto flex-col text-base leading-7 text-slate-500 dark:text-slate-400">
    <p class="flex-auto">{description}</p>
  </dd>
</article>
