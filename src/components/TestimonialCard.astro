---
interface Props {
  quote: string;
  author: string;
  role: string;
}

const { quote, author, role } = Astro.props;
---

<blockquote class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 flex flex-col justify-between hover:border-blue-100 transition-colors">
  <p class="text-lg leading-8 text-gray-900 font-medium italic">
    “{quote}”
  </p>
  <footer class="mt-8 flex items-center gap-x-4 border-t border-gray-50 pt-6">
    <div class="text-sm">
      <div class="font-bold text-gray-900">{author}</div>
      <div class="text-gray-600">{role}</div>
    </div>
  </footer>
</blockquote>
