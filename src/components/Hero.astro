---
interface Props {
  headline: string;
  subheadline: string;
}

const { headline, subheadline } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-white dark:bg-slate-950 px-6 py-12 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-3xl text-center reveal">
    <h1 class="text-balance text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-7xl">
      {headline}
    </h1>
    <p class="mt-8 text-pretty text-lg font-medium text-slate-500 dark:text-slate-400 sm:text-xl/8">
      {subheadline}
    </p>
    <slot />
  </div>
</section>
