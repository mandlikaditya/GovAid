---
---

<section id="features" class="py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base/7 font-semibold text-blue-700 uppercase tracking-wide">Features</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Everything you need to apply</p>
    </div>
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <div class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        <article class="flex flex-col items-start justify-between p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-x-4 text-xs font-semibold uppercase tracking-wider text-blue-700">
            Secure Upload
          </div>
          <div class="group relative">
            <h3 class="mt-3 text-2xl font-bold leading-6 text-gray-900 group-hover:text-blue-700">
              <a href="#">
                <span class="absolute inset-0"></span>
                Secure Document Vault
              </a>
            </h3>
            <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600">
              State-of-the-art encryption for your sensitive documents. We ensure your data stays private and safe throughout the process.
            </p>
          </div>
        </article>
        <article class="flex flex-col items-start justify-between p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-x-4 text-xs font-semibold uppercase tracking-wider text-blue-700">
            Smart Check
          </div>
          <div class="group relative">
            <h3 class="mt-3 text-2xl font-bold leading-6 text-gray-900 group-hover:text-blue-700">
              <a href="#">
                <span class="absolute inset-0"></span>
                Eligibility Engine
              </a>
            </h3>
            <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600">
              Our advanced algorithm compares your data with thousands of programs to identify every potential benefit you qualify for.
            </p>
          </div>
        </article>
        <article class="flex flex-col items-start justify-between p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
          <div class="flex items-center gap-x-4 text-xs font-semibold uppercase tracking-wider text-blue-700">
            AI Assistant
          </div>
          <div class="group relative">
            <h3 class="mt-3 text-2xl font-bold leading-6 text-gray-900 group-hover:text-blue-700">
              <a href="#">
                <span class="absolute inset-0"></span>
                Personal AI Guide
              </a>
            </h3>
            <p class="mt-5 line-clamp-3 text-sm leading-6 text-gray-600">
              A 24/7 intelligent assistant to answer your questions, explain requirements, and guide you through form completions.
            </p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
