<section id="how-it-works" class="py-24 sm:py-32 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-base/7 font-semibold text-blue-700 uppercase tracking-wide">How it works</h2>
      <p class="mt-2 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Simple 3-step process</p>
    </div>
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-gray-900">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white">1</span>
            Initial Assessment
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">Provide basic information about your situation. Our system will analyze your data securely to find relevant aid programs.</p>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-gray-900">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white">2</span>
            Document Upload
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">Upload necessary documents directly through our secure portal. We’ll guide you on exactly what’s needed for each program.</p>
          </dd>
        </div>
        <div class="flex flex-col">
          <dt class="flex items-center gap-x-3 text-xl font-bold leading-7 text-gray-900">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-700 text-white">3</span>
            Submit & Track
          </dt>
          <dd class="mt-4 flex flex-auto flex-col text-base leading-7 text-gray-600">
            <p class="flex-auto">We’ll help you submit your applications and track their status in real-time. You’ll be notified of any updates immediately.</p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
