---
import { Image } from 'astro:assets';
---
<div class="mx-auto max-w-7xl px-6 lg:px-8 mt-16 sm:mt-24 mb-12">
  <div class="relative rounded-xl bg-gray-900/5 p-2 ring-1 ring-inset ring-gray-900/10 lg:-m-4 lg:rounded-2xl lg:p-4 shadow-2xl overflow-hidden">
    <Image 
      src="https://placehold.co/1200x800/2563eb/white?text=GovAid+Dashboard" 
      alt="GovAid Application Dashboard" 
      width={1200}
      height={800}
      loading="eager"
      format="webp"
      class="rounded-md shadow-2xl ring-1 ring-gray-900/10 aspect-[16/10] object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-white/10 to-transparent pointer-events-none" />
  </div>
</div>
